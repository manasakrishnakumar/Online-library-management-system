{
  "uid": "library-overview",
  "title": "Online Library: service overview",
  "tags": ["library", "microservices"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Loans issued", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(library_loans_issued_total)", "refId": "A" }]
    },
    {
      "id": 2, "type": "stat", "title": "Loans returned", "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(library_loans_returned_total)", "refId": "A" }]
    },
    {
      "id": 3, "type": "stat", "title": "Loans pending (saga)", "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(library_loans_pending)", "refId": "A" }]
    },
    {
      "id": 4, "type": "stat", "title": "Outbox events waiting", "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(library_outbox_pending)", "refId": "A" }]
    },
    {
      "id": 5, "type": "stat", "title": "Fines assessed", "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(library_fines_assessed_total)", "refId": "A" }]
    },
    {
      "id": 6, "type": "stat", "title": "Notifications stored", "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(library_notifications_total)", "refId": "A" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "HTTP requests per second by service", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{application}}", "refId": "A" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "p95 response time (s) by service", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[1m])))", "legendFormat": "{{application}}", "refId": "A" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "Server errors (5xx) per second", "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "legendFormat": "{{application}}", "refId": "A" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "Circuit breaker open (1 = open)", "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "resilience4j_circuitbreaker_state{state=\"open\"}", "legendFormat": "{{application}} / {{name}}", "refId": "A" }]
    },
    {
      "id": 11, "type": "timeseries", "title": "JVM heap used (MiB)", "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"}) / 1048576", "legendFormat": "{{application}}", "refId": "A" }]
    }
  ]
}
